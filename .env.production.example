# =====================================================================
# TEMPLATE Production — Hostinger Node.js + MySQL
# =====================================================================
# 1) Salin template ini di PANEL Hostinger (bukan di file lokal):
#    hPanel -> Websites -> Manage -> Advanced -> Environment Variables, atau
#    Node.js hosting -> Application -> Environment Variables.
#
# 2) JANGAN pernah commit file berisi nilai asli ke Git.
#    File ini HANYA berisi placeholder & contoh format.
#
# 3) Lokal tetap pakai .env.local (sudah di .gitignore).
# ---------------------------------------------------------------------

# WAJIB di production (min 32 karakter acak)
# Generate:  openssl rand -base64 48   (di terminal / WSL)
JWT_SECRET=ganti_dengan_random_secret_minimal_32_karakter

# Hostinger: isi PASTI dari panel MySQL Databases (bukan localhost 3306)
# Opsi A — full URL:
# MYSQL_URL=mysql://u123456789_akselera:RAHASIA@auth-dbXXX.hostinger.com:3306/u123456789_akselera_chat

# Opsi B — split env (dipakai bila MYSQL_URL kosong):
MYSQL_HOST=auth-dbXXX.hostinger.com
MYSQL_PORT=3306
MYSQL_USER=u123456789_akselera
MYSQL_PASSWORD=ganti-password-asli-dari-panel
MYSQL_DATABASE=u123456789_akselera_chat

# Opsional (hostinger biasanya https sudah):
# NODE_ENV=production
