# JWT_SECRET (WAJIB di production, min 32 karakter acak)
# Generate: openssl rand -base64 48
JWT_SECRET="ganti_dengan_random_secret_minimal_32_karakter"

# --- MySQL / MariaDB (WAJIB untuk data persist di production, mis. Hostinger) ---
# Pakai MySQL_URL (URL lengkap) ATAU env individual di bawah.
# Contoh URL: mysql://user:password@host:3306/dbname
MYSQL_URL=""
MYSQL_HOST=""
MYSQL_PORT=3306
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE=""

# --- Opsional: PostgreSQL (Vercel/Neon/Supabase) ---
# Dipakai HANYA bila tidak ada env MySQL di atas (lihat lib/db.ts detectBackend).
# POSTGRES_URL=""

# --- Opsional: mode JSON untuk dev tanpa database ---
# Default: ./data/database.json
# DATABASE_FILE="./data/database.json"