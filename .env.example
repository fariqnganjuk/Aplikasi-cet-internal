# JWT_SECRET (WAJIB di production, min 32 karakter acak)
# Generate: openssl rand -base64 48
JWT_SECRET="ganti_dengan_random_secret_minimal_32_karakter"

# POSTGRES_URL (WAJIB untuk data persist di Vercel/production)
# Isi dari Vercel Storage -> Postgres, Neon, atau Supabase.
# DATABASE_URL juga didukung sebagai alias.
# Contoh: postgresql://user:password@host:5432/dbname?sslmode=require
POSTGRES_URL=""

# DATABASE_FILE (opsional, hanya untuk mode JSON lokal/dev)
# Default: ./data/database.json
# DATABASE_FILE="./data/database.json"